# ──────────────────────────────────────────────
# Netflix FA Stream — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ──────────────────────────────────────────────

# Vercel Postgres (Prisma)
DATABASE_URL="postgresql://user:password@host:5432/neondb?sslmode=require"

# Upstash Redis (session cache / rate limiting)
UPSTASH_REDIS_REST_URL="https://your-region.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# NextAuth v5
NEXTAUTH_SECRET="generate-a-random-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth App
GITHUB_ID="your-github-oauth-client-id"
GITHUB_SECRET="your-github-oauth-client-secret"

# Stripe (payment processing)
STRIPE_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Public
NEXT_PUBLIC_APP_URL="http://localhost:3000"